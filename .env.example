# Blockdium frontend — environment variables
#
# Copy to `.env.local` and adjust. All values are optional for local development.

# Base URL of the Blockdium API.
# Default: http://127.0.0.1:8080
VITE_API_BASE_URL=http://127.0.0.1:8080

# EVM JSON-RPC endpoint that the "Add Mainchain Devnet" button writes into MetaMask.
#
# ⚠️ IMPORTANT BEFORE DEPLOYING: this URL is stored permanently in each visitor's
# wallet. The default (http://127.0.0.1:8545) only works on the machine running the
# node — a visitor on any other machine will add a chain they cannot reach. Set this
# to a publicly reachable endpoint for any deployment.
#
# Default: http://127.0.0.1:8545
VITE_EVM_RPC_URL=http://127.0.0.1:8545

# Public URL of this explorer, used as MetaMask's "block explorer" link.
# Omit it entirely and no explorer link is added — better than a wrong URL that sends
# users to a 404 from inside their wallet.
# VITE_EXPLORER_URL=https://explorer.example
