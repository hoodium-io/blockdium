# Blockdium frontend — environment variables
#
# Copy to `.env.local` and adjust. Every value here is OPTIONAL: the defaults point at
# the official public Devnet and a local API.

# Base URL of the Blockdium API.
# Default: http://127.0.0.1:8080
VITE_API_BASE_URL=http://127.0.0.1:8080

# EVM JSON-RPC endpoint written into MetaMask by the "Add Mainchain Devnet" button.
#
# Default: https://rpc.hoodium.dev  (official public Devnet RPC — verified: eth_chainId
# returns 0x19c0/6592 and its block hashes match the chain)
#
# Override only to point a build at a local or private node. Note that MetaMask stores
# this URL permanently in the visitor's wallet, so a loopback value such as
# http://127.0.0.1:8545 would give every visitor a chain they cannot reach.
# VITE_EVM_RPC_URL=https://rpc.hoodium.dev

# Public URL of this explorer, used as MetaMask's "block explorer" link.
# Omit it and no explorer link is added — better than a wrong URL that sends users to
# a 404 from inside their wallet.
# VITE_EXPLORER_URL=https://explorer.hoodium.dev
